# =============================================================================
# AI Freight Copilot — Environment Configuration
# =============================================================================

# Application
APP_NAME=AI Freight Copilot
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production
APP_CORS_ORIGINS=["http://localhost:3000"]

# SQL Server (ERP Database — READ ONLY)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=FreightERP
SQLSERVER_USER=readonly_user
SQLSERVER_PASSWORD=your-password-here
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# PostgreSQL (Application State)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=freight_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=your-password-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# AI Providers
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Local vLLM
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3-8b-chat-hf

# Email (Resend)
RESEND_API_KEY=your-resend-key-here
RESEND_FROM_EMAIL=copilot@yourdomain.com
REPORT_RECIPIENTS=["ceo@company.com"]

# Scheduler
DAILY_REPORT_CRON=0 6 * * *
WEEKLY_REPORT_CRON=0 7 * * 1
MONTHLY_REPORT_CRON=0 7 1 * *
ANOMALY_SCAN_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
